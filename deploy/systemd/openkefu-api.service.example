[Unit]
Description=OpenKefu API
After=network.target mysql.service redis.service

[Service]
WorkingDirectory=/opt/openkefu
Environment=OPENKEFU_RUNTIME_ROLE=api
Environment=OPENKEFU_SERVER_HOST=0.0.0.0
Environment=OPENKEFU_SERVER_PORT=8000
ExecStart=/opt/openkefu/.venv/bin/python run_web.py --prod --role api
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
