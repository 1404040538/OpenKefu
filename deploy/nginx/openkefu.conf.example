upstream openkefu_api {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name example.com;
    server_tokens off;

    # Terminate TLS here (or at a trusted upstream proxy) in production.
    # HSTS sent by the application only takes effect over HTTPS.

    root /opt/openkefu/web/dist;
    index index.html;
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://openkefu_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace, rather than append, any client-supplied forwarding header.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://openkefu_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
