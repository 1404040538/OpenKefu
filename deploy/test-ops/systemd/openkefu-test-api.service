[Unit]
Description=OpenKefu Test API
After=network.target mysql.service openkefu-test-redis.service
Requires=openkefu-test-redis.service

[Service]
Type=simple
WorkingDirectory=/home/deploy/openkefu-test-deploy/current
Environment=PYTHONUNBUFFERED=1
Environment=OPENKEFU_RUNTIME_ROLE=api
Environment=OPENKEFU_SERVER_HOST=0.0.0.0
Environment=OPENKEFU_SERVER_PORT=18000
ExecStart=/home/deploy/openkefu-test-deploy/current/.venv/bin/python /home/deploy/openkefu-test-deploy/current/run_web.py --test --role api
ExecStartPost=/home/deploy/openkefu-test-deploy/bin/wait-for-test-api
Restart=always
RestartSec=5
TimeoutStartSec=150
TimeoutStopSec=30

[Install]
WantedBy=default.target
