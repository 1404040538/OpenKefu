config.local.json
logs/
data/
qrcodes/
temp/
output
*.log

# ===== 前端构建产物 =====
web/node_modules/
web/dist/
.npm-cache/

# ===== Python 运行时 =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ===== JS 逆向/分析产物（不入库） =====
web_source_js/
wen_source_js/
temp_api/
